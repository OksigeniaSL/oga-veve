{
  "name": "oga-veve",
  "version": "0.1.0",
  "description": "Simulador de vuelo para navegador — volar sobre Paraguay. Producto Oksigenia SL bajo la marca Granja Óga.",
  "license": "Apache-2.0",
  "private": false,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build && node scripts/hacer-sw.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "terreno": "node scripts/hgt-a-heightmap.mjs",
    "vuelo": "node scripts/verificar-despegue.mjs tenerife-norte guyrami && node scripts/verificar-despegue.mjs pettirossi guyrami && node scripts/verificar-vuelo.mjs tenerife-norte guyrami && node scripts/verificar-vuelo.mjs pettirossi taguato && node scripts/verificar-despegue.mjs yvytu-rape guyrami && node scripts/verificar-vuelo.mjs yvytu-rape guyrami",
    "vuelo-entero": "node scripts/verificar-vuelo-entero.mjs",
    "barrido": "node scripts/barrido.mjs",
    "rendimiento": "node scripts/verificar-rendimiento.mjs",
    "acceso": "node scripts/verificar-acceso.mjs",
    "paneles": "node scripts/verificar-paneles.mjs",
    "percance": "node scripts/verificar-percance.mjs",
    "viento": "node scripts/verificar-viento.mjs",
    "sin-red": "node scripts/verificar-sin-red.mjs",
    "voz": "node scripts/verificar-voz.mjs",
    "frenos": "node scripts/verificar-frenos.mjs",
    "rodaje": "node scripts/verificar-asistencia.mjs",
    "pictos": "node scripts/verificar-pictos.mjs",
    "librea": "node scripts/verificar-librea.mjs",
    "cabina": "node scripts/verificar-cabina.mjs",
    "carteles": "node scripts/verificar-carteles.mjs",
    "quien-habla": "node scripts/verificar-quien-habla.mjs",
    "modelos": "node scripts/hacer-modelos.mjs",
    "cambio-de-avion": "node scripts/verificar-cambio-de-avion.mjs",
    "circuito": "node scripts/verificar-circuito.mjs",
    "voces": "node scripts/verificar-voces.mjs",
    "botones": "node scripts/verificar-botones.mjs",
    "cuadro": "node scripts/verificar-cuadro.mjs",
    "panel": "node scripts/verificar-panel.mjs",
    "frecuencia": "node scripts/verificar-frecuencia.mjs",
    "tren": "node scripts/verificar-tren.mjs"
  },
  "dependencies": {
    "3d-tiles-renderer": "^0.5.2",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/three": "^0.180.0",
    "playwright": "^1.62.1",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  }
}
