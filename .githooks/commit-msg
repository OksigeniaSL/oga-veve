#!/bin/sh
#
# Ningún commit acredita una herramienta.
#
# La regla está en `AGENTS.md` desde el principio —«no se acreditan
# herramientas de desarrollo, ni de asistencia, ni de generación, ni en el
# repositorio ni en el juego ni en los mensajes de commit»— y aun así se
# coló en 539 de 619 commits antes de que nadie la mirara. Una regla que solo
# vive en un documento se cumple mientras alguien se acuerda; escrita aquí se
# cumple sola.
#
# Y el sitio importa: esto va en el gancho, no solo en CI, porque una
# coletilla atajada en CI ya está en la historia local de quien la escribió y
# sacarla cuesta una reescritura. Atajada aquí, no llega a existir.
#
# Se instala con `npm install` —ver el guion `prepare` en `package.json`, que
# apunta `core.hooksPath` a esta carpeta—, así que un clon nuevo lo tiene sin
# hacer nada. Y hay un segundo cerrojo en CI por si alguien comitea con
# `--no-verify`: ver `.github/workflows/ci.yml`.

mensaje="$1"

# Lo que no puede aparecer, y por qué cada uno:
#
#   Co-Authored-By: … <noreply@anthropic.com>   una herramienta como coautora
#   Claude-Session: …                           el cuaderno de una herramienta
#   Generated with …                            el pie de generación
#   claude.ai/code/…                            un enlace a ese cuaderno
#
# Ojo con el primero: `Co-Authored-By` **es legítimo** para una persona que
# ha escrito código. Lo que no vale es el correo de la herramienta, así que
# se mira el correo y no la etiqueta.
prohibido='(<noreply@anthropic\.com>|^Claude-Session:|^Co-Authored-By:.*\bClaude\b|Generated with \[|claude\.ai/code/)'

sobra=$(grep -nEi "$prohibido" "$mensaje")

if [ -n "$sobra" ]; then
	cat >&2 <<-FIN

	  ✗ Este mensaje de commit acredita una herramienta, y aquí no se hace.

	$(printf '%s\n' "$sobra" | sed 's/^/      /')

	  Quita esas líneas y vuelve a comitear. La regla y su porqué están en
	  AGENTS.md, apartado «Publicación».

	FIN
	exit 1
fi

exit 0
